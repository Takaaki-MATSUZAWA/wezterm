# 目的: Debian/Ubuntu 系ディストリ向けに headless wezterm（wezterm cli + wezterm-mux-server）を
#       ビルドする環境イメージ。arm64 は同じ x86_64 コンテナから multiarch でクロスビルドする
# 関連: ci/docker/build.sh（これを経由して使う）, ci/docker/inside-linux.sh
# 前提: ビルドコンテキストは空でよい
ARG BASE=ubuntu:22.04
FROM ${BASE}

ENV DEBIAN_FRONTEND=noninteractive

# arm64 のパッケージを取れるように multiarch を設定する。
# Debian は同じミラーに全アーキがあるが、Ubuntu は arm64 が ports.ubuntu.com に分かれている。
RUN set -eux; \
    . /etc/os-release; \
    dpkg --add-architecture arm64; \
    if [ "$ID" = ubuntu ]; then \
      if [ -f /etc/apt/sources.list.d/ubuntu.sources ]; then \
        sed -i '/^Types:/a Architectures: amd64' /etc/apt/sources.list.d/ubuntu.sources; \
        printf 'Types: deb\nURIs: http://ports.ubuntu.com/ubuntu-ports\nSuites: %s %s-updates %s-security\nComponents: main universe\nArchitectures: arm64\nSigned-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg\n' \
          "$VERSION_CODENAME" "$VERSION_CODENAME" "$VERSION_CODENAME" > /etc/apt/sources.list.d/ports.sources; \
      else \
        sed -i 's/^deb http/deb [arch=amd64] http/' /etc/apt/sources.list; \
        for s in "" -updates -security; do \
          echo "deb [arch=arm64] http://ports.ubuntu.com/ubuntu-ports ${VERSION_CODENAME}${s} main universe" >> /etc/apt/sources.list; \
        done; \
      fi; \
    fi; \
    echo 'APT::Install-Recommends "0";' > /etc/apt/apt.conf.d/99-no-recommends; \
    apt-get update; \
    apt-get install -y ca-certificates curl git build-essential pkg-config perl xz-utils \
      libssl-dev zlib1g-dev \
      gcc-aarch64-linux-gnu g++-aarch64-linux-gnu libc6-dev-arm64-cross \
      libssl-dev:arm64 zlib1g-dev:arm64; \
    rm -rf /var/lib/apt/lists/*

# Rust は rustup で入れる（ディストリ同梱版は古すぎる）
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
ARG RUST_VERSION=stable
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain ${RUST_VERSION} \
 && rustup target add aarch64-unknown-linux-gnu \
 && chmod -R a+rwX /opt/rustup /opt/cargo

# aarch64 クロスビルド設定
ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc \
    CC_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc \
    CXX_aarch64_unknown_linux_gnu=aarch64-linux-gnu-g++ \
    AR_aarch64_unknown_linux_gnu=aarch64-linux-gnu-ar \
    PKG_CONFIG_aarch64_unknown_linux_gnu=/usr/local/bin/aarch64-linux-gnu-pkg-config
RUN printf '#!/bin/sh\nexport PKG_CONFIG_LIBDIR=/usr/lib/aarch64-linux-gnu/pkgconfig:/usr/share/pkgconfig\nexport PKG_CONFIG_ALLOW_CROSS=1\nexec pkg-config "$@"\n' \
      > /usr/local/bin/aarch64-linux-gnu-pkg-config \
 && chmod +x /usr/local/bin/aarch64-linux-gnu-pkg-config

# 一部の git 依存が ssh URL なので https に書き換える
ENV CARGO_NET_GIT_FETCH_WITH_CLI=true
RUN git config --system url."https://github.com/".insteadOf "git@github.com:" \
 && git config --system --add safe.directory '*'
